{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm run build:vercel",
  "outputDirectory": "artifacts/reactivation-power/dist/public",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.mjs": { "maxDuration": 300 }
  },
  "crons": [
    { "path": "/api/cron/demo-reset", "schedule": "0 7,8 * * *" },
    { "path": "/api/cron/auth-cleanup", "schedule": "0 8,9 * * *" },
    { "path": "/api/cron/billing-retry", "schedule": "0 10,11 * * *" },
    { "path": "/api/cron/workers", "schedule": "1,6,11,16,21,26,31,36,41,46,51,56 * * * *" }
  ]
}
